# ── Required for production preset ──
ELEVENLABS_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── Optional: AI narration generation ──
ANTHROPIC_API_KEY=

# ── Lambda rendering (optional) ──
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Provider overrides (optional, CLI flags take precedence) ──
# TTS_PROVIDER=edge          # edge (free) | elevenlabs (premium) | kokoro (local)
# AVATAR_PROVIDER=none       # none | sadtalker | liveportrait | echomimic
# AVATAR_IMAGE=              # Path to reference face image for talking head
# WHISPER_MODEL=medium.en    # tiny.en | base.en | small.en | medium.en | large-v3
